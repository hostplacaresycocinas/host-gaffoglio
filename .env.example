# Google Analytics 4 — ID de medición (público, por sitio / concesionaria)
# Formato G-XXXXXXXXXX. Usá el Measurement ID propio de ESTA concesionaria,
# no el de otro proyecto, para no contaminar los analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-TW6P783WB2

# GA4 Data API (server-side, para el panel /admin/analytics)
# Property ID numérico (NO el measurement ID). Lo encontrás en:
# GA4 → Admin → Property Settings → Property Details
GA4_PROPERTY_ID=

# JSON completo de la clave del Service Account (en una sola línea).
# Pasos:
#   1. Google Cloud Console → IAM → Service Accounts → Create
#   2. Crear key tipo JSON y descargar
#   3. Habilitar "Google Analytics Data API" en el proyecto
#   4. En GA4 → Admin → Property Access Management → agregar el email
#      del service account con rol "Viewer"
#   5. Pegar acá el contenido del JSON (escapar comillas si hace falta)
GOOGLE_APPLICATION_CREDENTIALS_JSON=
